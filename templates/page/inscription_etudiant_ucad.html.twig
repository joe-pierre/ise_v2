{% extends 'base.html.twig' %}

{% block title %}
	{{website_name ~ ' - Procédure d’inscription pour les étudiants régulièrements inscrits à l’UCAD
'}}
{% endblock %}

{% block javascripts %}
	{% block importmap %}
		{{ importmap(['app', 'admission']) }}
	{% endblock %}
{% endblock %}

{% block body %}
	<div class="page-title aos-init aos-animate" data-aos="fade">
		<div class="container d-lg-flex justify-content-between align-items-center">
			<h1 class="mb-2 mb-lg-0">Procédure d’inscription pour les étudiants régulièrements inscrits à l’UCAD</h1>
			<nav class="breadcrumbs">
				<ol>
					<li>
						<a href="{{ path('app_home') }}">Accueil</a>
					</li>
					<li>Procédure</li>
				</ol>
			</nav>
		</div>
	</div>

	<section id="admission-section" class="container admission-section section">

		<div class="section-title aos-init aos-animate" data-aos="fade-up">
			<h2>Procédure</h2>
		</div>

		<div class="container col-md-8 max-auto amdission-pt-0 aos-init aos-animate" data-aos="fade-up">

			<p>Pour les <strong>étudiants de l’UCAD</strong>, c'est-a-dire ceux qui jusque-là se sont toujours inscrits à l’UCAD, le candidat doit fournir un dossier complet contenant les documents suivants :</p>

			{# <twig:ApplicationFile master="true" bachelor="true" /> #}

			{% include '_partials/dossier_candidature_etudiant.html.twig' with {'page': 'inscription_etudiant_ucad' } %}

			{% include '_partials/info_post_admission.html.twig' %}

		</div>

	</section>
{% endblock %}
