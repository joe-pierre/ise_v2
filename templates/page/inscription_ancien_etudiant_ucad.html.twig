{% extends 'base.html.twig' %}

{% block title %}
	{{website_name ~ ' - Procédure d’inscription pour les anciens étudiants de l’UCAD'}}
{% endblock %}

{% block javascripts %}
	{% block importmap %}
		{{ importmap(['app', 'admission']) }}
	{% endblock %}
{% endblock %}

{% block body %}
	<div class="page-title aos-init aos-animate" data-aos="fade">
		<div class="container d-lg-flex justify-content-between align-items-center">
			<h1 class="mb-2 mb-lg-0">Procédure d’inscription pour les anciens étudiants de l’UCAD</h1>
			<nav class="breadcrumbs">
				<ol>
					<li>
						<a href="{{ path('app_home') }}">Accueil</a>
					</li>
					<li>Procédure</li>
				</ol>
			</nav>
		</div>
	</div>

	<section id="admission-section" class="container admission-section section">

		<div class="section-title aos-init aos-animate" data-aos="fade-up">
			<h2>Procédure</h2>
		</div>

		{# <twig:RegistrationProcess foreignStudent="true" /> #}
		{# <twig:RegistrationProcess formerStudent="true" /> #}

		{% include '_partials/procedure_inscription.html.twig' with { foreignStudent: false, formerStudent: true } %}


	</section>
{% endblock %}
