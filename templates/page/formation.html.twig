{% extends 'base.html.twig' %}

{% block title %}
	{{website_name ~ ' - Formations'}}
{% endblock %}

{% block ldjson %}
	<script type="application/ld+json">
	{
	"@context": "https://schema.org",
	"@type": "Course",
	"name": "Institut des Sciences de l’Environnement - Formations",
	"provider": {
		"@type": "CollegeOrUniversity",
		"name": "Institut des Sciences de l’Environnement"
	},
	"educationalCredentialAwarded": "Master, Licence",
	"hasCourseInstance": {
		"@type": "CourseInstance",
		"courseMode": "En présentiel",
		"instructor": "Enseignants-chercheurs et professionnels du secteur"
	}
	}
	</script>
{% endblock %}

{% block javascripts %}
	{% block importmap %}
		{{ importmap(['app', 'formation']) }}
	{% endblock %}
{% endblock %}

{% block body %}
	<div class="page-title aos-init aos-animate" data-aos="fade">
		<div class="container d-lg-flex justify-content-between align-items-center">
			<h1 class="mb-2 mb-lg-0">Formations</h1>
			<nav class="breadcrumbs">
				<ol>
					<li>
						<a href="{{ path('app_home') }}">Accueil</a>
					</li>
					<li>Formations</li>
				</ol>
			</nav>
		</div>
	</div>

	<section id="formation-section" class="container formation-section section" aria-labelledby="formations-title">
		<div class="col-md-8 col-lg-8 mx-auto">

			<div class="aos-init aos-animate" data-aos="fade-up">
				<div class="section-title aos-init aos-animate" data-aos="fade-up">
					<header>
						<h2 id="formations-title">Nos Formations à l'ISE</h2>
						<p>Découvrez nos programmes de formation en journée et en soirée, conçus pour permettre aux professionnels et aux étudiants en activité de concilier leurs études avec leur emploi du temps.:</p>
					</header>
				</div>
			</div>

			<!-- Cours du jour -->
			<section class="container">

				<!-- LPE -->
				{% include '_partials/formation_page/lpe.html.twig' with { inscritionOpened: true }  %}

				<!-- ENVI -->
				{% include '_partials/formation_page/envi.html.twig' with { inscritionOpened: false }  %}

			</section>

			<!-- Cours du soir -->
			<section class="container">

				<!-- GERENAD -->
				{% include '_partials/formation_page/gerenad.html.twig' with { inscritionOpened: true }  %}

				<!-- RSE -->
				{% include '_partials/formation_page/rse.html.twig' with { inscritionOpened: true }  %}

				<!-- EGRM -->
				{% include '_partials/formation_page/egrm.html.twig' with { inscritionOpened: true }  %}

				<!-- AP -->
				{% include '_partials/formation_page/ap.html.twig' with { inscritionOpened: true } %}

			</section>
		</div>
	</section>

{% endblock %}
