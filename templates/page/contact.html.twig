{% extends 'base.html.twig' %}

{% block title %}
	{{website_name ~ ' - Contact'}}
{% endblock %}

{% block javascripts %}
	{% block importmap %}
		{{ importmap(['app', 'contact']) }}
	{% endblock %}
{% endblock %}

{% block body %}
	<div class="page-title aos-init aos-animate" data-aos="fade">
		<div class="container d-lg-flex justify-content-between align-items-center">
			<h1 class="mb-2 mb-lg-0">Contact</h1>
			<nav class="breadcrumbs">
				<ol>
					<li>
						<a href="{{ path('app_home') }}">Accueil</a>
					</li>
					<li>Contact</li>
				</ol>
			</nav>
		</div>
	</div>

	<section id="contact-section" class="container contact-section section" aria-labelledby="contact-title">
		<div class="aos-init aos-animate" data-aos="fade-up">
			<div class="section-title aos-init aos-animate" data-aos="fade-up">
				<header>
					<h2 id="contact-title">Laissez-nous un message!</h2>
				</header>
			</div>
		</div>
	</section>

	<section class="container contact">

		<div class="row mb-3">
			<div class="col-md-6 themed-grid-col">
				<div class="row mb-4">
					<div class="col-md-6 themed-grid-col">

						<h4>Contact :</h4>
						<div class="d-flex contact-info">
							<i class="bi bi-envelope"></i>
							<p><a href="mailto:{{ website_email }}">{{ website_email }}</a></p>
						</div>

						<div class="d-flex contact-info">
							<i class="bi bi-phone"></i>
							<p><a href="tel:{{ website_phone }}">{{ website_phone }}</a></p>
						</div>
					</div>
					<div class="col-md-6 themed-grid-col horaire">
						<h4>Horaires :</h4>
						<p>
							<strong>Lundi - Vendredi :</strong>
						</p>
						<p>
							09h00 - 13h00 | <strong>PAUSE</strong> | 15h00 - 17h00
						</p>
					</div>
				</div>
				<div class="map-container rounded overflow-hidden">
					<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3859.5035853614436!2d-17.466495424892223!3d14.68409028581219!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xec172883310cd01%3A0xf8b145d125d6014a!2sInstitut%20des%20Sciences%20de%20l'Environnement!5e0!3m2!1sfr!2ssn!4v1698164692053!5m2!1sfr!2ssn" frameborder="0" style="border:0; width: 100%; height: 100%;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>

			<div class="col-md-6 themed-grid-col">
				<turbo-frame id="contact-form">
					{{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
					
					<div class="row mb-3">
						<div class="form-group col-md-6">
							{{ form_label(form.fullname, null, {'label_attr': {'class': 'col-form-label col-sm-2 required w-100'}}) }}
							{{ form_widget(form.fullname, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.fullname) }}
						</div>
						<div class="form-group col-md-6">
							{{ form_label(form.email) }}
							{{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.email) }}
						</div>
					</div>

					<div class="form-group mb-3">
						{{ form_label(form.subject) }}
						{{ form_widget(form.subject, {'attr': {'class': 'form-control'}}) }}
						{{ form_errors(form.subject) }}
					</div>

					<div class="form-group">
						{{ form_label(form.message) }}
						{{ form_widget(form.message, {'attr': {'class': 'form-control'}}) }}
						{{ form_errors(form.message) }}
					</div>

					<div class="mt-4 text-center">
						<button class="btn-primary w-100" type="submit">Envoyer</button>
					</div>

					{{ form_end(form) }}
				</turbo-frame>
			</div>
		</div>

	</section>

{% endblock %}
