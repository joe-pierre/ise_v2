    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfModalLabel">
                    <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>
                    Sujets des années passées
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body p-0">
                <iframe
                    src="/infos/anciens-sujets-concours-d-entree-master-sciences-de-l-environnement.pdf"
                    width="100%"
                    height="600px"
                    style="border: none;"
                    title="Sujets des années passées"
                ></iframe>
            </div>
            <div class="modal-footer">
                <a href="/infos/anciens-sujets-concours-d-entree-master-sciences-de-l-environnement.pdf" download class="btn btn-success btn-sm">
                    <i class="bi bi-download me-1"></i> Télécharger
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>