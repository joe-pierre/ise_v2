<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta content="width=device-width, initial-scale=1.0" name="viewport">

        {% block metadata %}
            <meta name="description" content="Institut des Sciences de l’Environnement (ISE) – FST - UCAD. Formations, admissions et concours dans les métiers de l’environnement.">
            <meta name="keywords" content="ISE, UCAD, Environnement, Dakar, Concours, Master, Licence, Sciences de l’environnement">

            <meta property="og:title" content="Institut des Sciences de l’Environnement (ISE)">
            <meta property="og:description" content="Institut des Sciences de l’Environnement (ISE) – FST - UCAD. Formations, admissions et concours.">
            <meta property="og:image" content="{{ asset('img/ise/logo-ise.png') }}">
            <meta property="og:url" content="{{ app.request.uri }}">
            <meta property="og:type" content="website">

            <meta name="twitter:card" content="summary_large_image">
        {% endblock %}


        <title>{% block title %}{{website_name}}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <!-- Favicons -->
        <link href="assets/img/favicon.png" rel="icon">
        <link href="assets/img/apple-touch-icon.png" rel="apple-touch-icon">

        <!-- Fonts -->
        <link href="https://fonts.googleapis.com" rel="preconnect">
        <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

        <!-- Bootstrap CDN -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

        <!-- Bootstrap Icons CDN -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

        <!-- AOS CDN -->
        <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />

        {% block ldjson %}
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "CollegeOrUniversity",
                "name": "Institut des Sciences de l’Environnement (ISE)",
                "url": "https://ise.sn",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Dakar",
                    "addressCountry": "SN"
                },
                "parentOrganization": {
                    "@type": "CollegeOrUniversity",
                    "name": "Université Cheikh Anta Diop de Dakar"
                }
            }
            </script>
        {% endblock %}


        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap(['app', 'home']) }}{% endblock %}
        {% endblock %}
    </head>
    <body data-controller="hello">
        <twig:Header />

        <main class="main" role="main">
            {% block body %}{% endblock %}
        </main>

    	<twig:Footer />
    
        <!-- Scroll Top -->
        <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center">
            <i class="bi bi-arrow-up-short"></i>
        </a>

        <!-- Preloader -->
        <div id="preloader">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
        </div>

        <!-- AOS CDN -->
        <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
        <script>
        AOS.init({
            once: true
        });
        </script>
    </body>
</html>
