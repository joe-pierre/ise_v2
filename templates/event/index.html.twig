        <div class="row">

          <div class="col-lg-8">

            <!-- Event Item -->
            <article class="event-card aos-init aos-animate" data-aos="fade-up" data-aos-delay="200">
              <div class="row g-0">
                <div class="col-md-4">
                  <div class="event-image">
                    <img src="{{ asset('img/ise/jme/affiche-jme-2026.jpeg') }}" class="img-fluid" alt="Event Image">
                    <div class="date-badge">
                      <span class="day">06</span>
                      <span class="month">Juin</span>
                    </div>
                  </div>
                </div>
                <div class="col-md-8">
                  <div class="event-content">
                    <div class="event-meta">
                      <span class="time"><i class="bi bi-calendar"></i>06 Juin 2026</span>
                      <span class="time"><i class="bi bi-clock"></i>A partir de 09h00'</span>
                      <span class="location"><i class="bi bi-geo-alt"></i>Salle de conférence - UCAD II</span>
                    </div>
                    <h3 class="event-title">
                      <a href="#">Journée Mondiale de l'Environnement (JME)</a>
                    </h3>
                    <p class="event-description">À l'occasion de la Journée Mondiale de l'Environnement 2026, l'Institut des Sciences de l'Environnement de l'Université Cheikh Anta Diop de Dakar réaffirme son engagement en faveur d'un développement durable et résilient. À travers des actions de sensibilisation, de reboisement, de salubrité et de mobilisation communautaire, l'ISE contribue activement à la protection de l'environnement et à la lutte contre les changements climatiques. Cette journée nous rappelle que chaque citoyen a un rôle essentiel à jouer pour préserver les ressources naturelles et construire un avenir meilleur pour les générations présentes et futures.</p>
                    <div class="event-footer">
                      <div class="instructor">
                        <img src="{{ asset('img/ise/ise.webp') }}" alt="Instructor" class="instructor-avatar">
                        <span>Envi 36 & Envi 37</span>
                      </div>
                      {# <div class="event-price">
                        <span class="price">$49</span>
                      </div> #}
                    </div>
                    <div class="event-actions">
                      {# <a href="#" class="btn btn-primary">Register Now</a> #}
                      <a href="{{ path('app_event_show') }}" class="btn btn-outline">En savoir plus</a>
                    </div>
                  </div>
                </div>
              </div>
            </article><!-- End Event Item -->


