<header{{ attributes }} id="header" class="header sticky-top" >
	<div class="topbar d-flex align-items-center dark-background">
		<div class="container d-flex justify-content-center justify-content-md-between">
			<div class="contact-info d-flex align-items-center">
				<i class="bi bi-envelope d-flex align-items-center">
					<a href="mailto:{{ website_email }}">{{ website_email }}</a>
				</i>
				<i class="bi bi-phone d-flex align-items-center ms-4">
					<a type="tel" href="tel:{{ website_phone }}">{{ website_phone }}</a>
				</i>
			</div>
		</div>
	</div>

	<div class="branding d-flex align-items-cente">

		<div class="container position-relative d-flex align-items-center justify-content-between">
			<div class="h-100">
				<a href="{{ path('app_home') }}" class="logo d-flex align-items-center h-100">
					<img src="{{ asset('img/ise/logo-ise.webp') }}" alt="Logo de l'ISE">
				</a>
			</div>

			<nav id="navmenu" class="navmenu">
				<ul>
					<li>
						<a href="{{ path('app_home') }}" class="{{ app.request.pathInfo == path('app_home') ? 'active' : '' }}">Accueil</a>
					</li>
					<li>
						<a href="{{ path('app_admission') }}" class="{{ app.request.pathInfo == path('app_admission') ? 'active' : '' }}">Admissions</a>
					</li>
					<li>
						<a href="{{ path('app_formation') }}" class="{{ app.request.pathInfo == path('app_formation') ? 'active' : '' }}">Formations</a>
					</li>
					{# <li>
						<a href="{{ path('app_enseignement') }}" class="{{ app.request.pathInfo == path('app_enseignement') ? 'active' : '' }}">Enseignements</a>
					</li> #}
					<li>
						<a href="{{ path('app_contact') }}" class="{{ app.request.pathInfo == path('app_contact') ? 'active' : '' }}">Contact</a>
					</li>
				</ul>
				<i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
			</nav>
		</div>

	</div>
</header>
