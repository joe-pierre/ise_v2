# Activer le moteur de réécriture
RewriteEngine On

# 1️⃣ Redirection du sous-domaine vers le domaine principal
RewriteCond %{HTTP_HOST} ^(www\.)?ise\.newspreneuriat\.com$ [NC]
RewriteRule ^(.*)$ https://ise.sn/$1 [R=301,L]

# 2️⃣ Forcer HTTPS pour ise.sn
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?ise\.sn$ [NC]
RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 3️⃣ Symfony - redirection vers /public
RewriteCond %{HTTP_HOST} ^(www\.)?ise\.sn$ [NC]
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /public/$1

# 4️⃣ Symfony - index.php par défaut
RewriteRule ^(/)?$ public/index.php [L]
